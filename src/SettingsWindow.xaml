<Window x:Class="Pconnect.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="540" Height="660" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#1E2029"/>
      <Setter Property="Foreground" Value="#F4F5F9"/>
      <Setter Property="BorderBrush" Value="#333747"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="#F4F5F9"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="7,3" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#4A4E63"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#8B5CF6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FieldBtn" TargetType="Button">
      <Setter Property="Background" Value="#262A38"/>
      <Setter Property="Foreground" Value="#D6DAE6"/>
      <Setter Property="BorderBrush" Value="#2E3245"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#30364A"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="10" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.9"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border x:Name="Surface" CornerRadius="20" Margin="10" BorderThickness="1" BorderBrush="#2A2D3D">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B1D29" Offset="0"/>
        <GradientStop Color="#10121B" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid Margin="24,20,24,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <TextBlock Text="Настройки профилей" FontSize="18" FontWeight="Bold" Foreground="#F4F5F9"/>
        <Button x:Name="SWClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="30" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#00FFFFFF" BorderThickness="0" Foreground="#8B91A5" Cursor="Hand"/>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,14,0,0">
        <TextBlock Text="Профиль" FontSize="11" Foreground="#8B91A5"/>
        <Grid Margin="0,5,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="ProfileCombo" Height="32" FontSize="12" Background="#1E2029" Foreground="#F4F5F9" BorderBrush="#333747"/>
          <Button x:Name="AddBtn" Content="＋ Добавить" Grid.Column="1" Height="32" Margin="8,0,0,0" Padding="12,0" Style="{StaticResource FieldBtn}"/>
          <Button x:Name="DelBtn" Content="🗑" Grid.Column="2" Width="40" Height="32" Margin="8,0,0,0" Style="{StaticResource FieldBtn}"/>
        </Grid>
      </StackPanel>
      <StackPanel Grid.Row="2" Margin="0,12,0,0">
        <TextBlock Text="Название" FontSize="11" Foreground="#8B91A5"/>
        <TextBox x:Name="FName" Height="28" Margin="0,3,0,8"/>
        <TextBlock Text="Команда подключения" FontSize="11" Foreground="#8B91A5"/>
        <TextBox x:Name="FConnect" Height="28" Margin="0,3,0,8"/>
        <TextBlock Text="Команда отключения" FontSize="11" Foreground="#8B91A5"/>
        <TextBox x:Name="FDisconnect" Height="28" Margin="0,3,0,8"/>
        <TextBlock Text="Адаптер (для статуса)" FontSize="11" Foreground="#8B91A5"/>
        <Grid Margin="0,3,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="FAdapter" Height="28"/>
          <Button x:Name="DetectBtn" Content="Подобрать" Grid.Column="1" Height="28" Margin="8,0,0,0" Padding="14,0" Style="{StaticResource FieldBtn}"/>
        </Grid>
        <TextBlock Text="Путь к приложению" FontSize="11" Foreground="#8B91A5"/>
        <TextBox x:Name="FClientPath" Height="28" Margin="0,3,0,8"/>
        <CheckBox x:Name="FFixRouting" Content="Исправлять маршрутизацию (IgnoreDefaultRoutes)" FontSize="12" Foreground="#D6DAE6" Margin="0,0,0,8"/>
        <TextBlock Text="Службы для отключения (через запятую)" FontSize="11" Foreground="#8B91A5"/>
        <TextBox x:Name="FServices" Height="28" Margin="0,3,0,8"/>
        <TextBlock Text="Процессы для завершения (через запятую)" FontSize="11" Foreground="#8B91A5"/>
        <TextBox x:Name="FProcesses" Height="28" Margin="0,3,0,8"/>
      </StackPanel>
      <StackPanel Grid.Row="3" Margin="0,6,0,0">
        <CheckBox x:Name="FKillSwitch" Content="Защита от обрыва — авто-переподключение при падении VPN" FontSize="12" Foreground="#D6DAE6"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button x:Name="SaveBtn" Content="Сохранить" Width="120" Height="36" Style="{StaticResource PrimaryBtn}" Background="#22C55E"/>
          <Button x:Name="CancelBtn" Content="Закрыть" Width="110" Height="36" Margin="10,0,0,0" Style="{StaticResource FieldBtn}"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
